// =============================================================
// Firestore のセキュリティルール（DarkSurvive）
// -------------------------------------------------------------
// ・カード／敵／イベントのデータは誰でも読める（ゲームが起動時に読み込むため）
// ・書き込みも誰でもできる（開発メニューからログインなしで反映するため）
//   ※ 公開ページを開いた人なら誰でも書き換え・削除できる状態です。
//     困ったときは、開発メニューの「JSON 書き出し」で取っておいたバックアップから戻せます。
// ・ゲームが読み込めない形のデータで壊れないよう、置き場所と項目名だけは制限する
//
// Firebase コンソールの「Firestore Database → ルール」に貼り付けて「公開」してください。
// =============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isContent(kind) {
      return kind in ['cards', 'enemies', 'events'];
    }

    match /{kind}/{id} {
      allow read: if isContent(kind);
      allow create, update: if isContent(kind)
        && id.matches('^[a-z0-9_]{1,64}$')
        && request.resource.data.keys().hasOnly(['def', 'deleted', 'updatedAt', 'updatedBy']);
      allow delete: if isContent(kind);
    }
  }
}
