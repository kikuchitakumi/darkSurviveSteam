// =============================================================
// Storage（画像）のセキュリティルール（DarkSurvive）
// -------------------------------------------------------------
// ・画像は誰でも読める（ゲームで表示するため）
// ・アップロードも誰でもできる（開発メニューからログインなしで反映するため）
//   ただし content/ の下だけ・画像だけ・5MB まで
//
// Firebase コンソールの「Storage → ルール」に貼り付けて「公開」してください。
// =============================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
