// =============================================================
// Storage（画像）のセキュリティルール（DarkSurvive）
// -------------------------------------------------------------
// ・画像は誰でも読める（ゲームで表示するため）
// ・アップロードできるのは「編集者」だけ。画像のみ・5MB まで
//
// ★EDITORS のメールアドレスを firestore.rules と同じものにしてから、
//   Firebase コンソールの「Storage → ルール」に貼り付けて「公開」してください。
// =============================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'editor1@example.com' // ← ここを自分のメールアドレスに変える
        ]
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
